#!/bin/sh
# Copyright (C) 2026 Daniele Stefano Continenza <daniele@dascos.info>
# SPDX-License-Identifier: AGPL-3.0-or-later
# Rimuove un IPv4, una rete IPv4 CIDR canonica o un IPv6 singolo
# dai ban globali banIP e, se presente, dal sottosistema f2b-portban.
set -eu

PATH='/usr/sbin:/usr/bin:/sbin:/bin'
TARGET="${1:-}"
LOGTAG='fw-unban-all'

log() { logger -t "$LOGTAG" -- "$*"; echo "$*"; }
die() { logger -t "$LOGTAG" -- "ERROR: $*"; echo "ERROR: $*" >&2; exit 1; }

is_ipv4() {
        local value="$1" old_ifs octet
        case "$value" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
        old_ifs="$IFS"; IFS='.'; set -- $value; IFS="$old_ifs"
        [ "$#" -eq 4 ] || return 1
        for octet in "$@"; do
                case "$octet" in 0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) : ;; *) return 1 ;; esac
                [ "$octet" -le 255 ] 2>/dev/null || return 1
        done
}

is_ipv4_cidr() {
        local target="$1" ip prefix old_ifs o1 o2 o3 o4 full remaining host_mask
        case "$target" in */*) : ;; *) return 1 ;; esac
        ip="${target%/*}"; prefix="${target#*/}"
        case "$ip" in */*) return 1 ;; esac
        case "$prefix" in */*) return 1 ;; esac
        is_ipv4 "$ip" || return 1
        case "$prefix" in 0|[1-9]|[1-2][0-9]|3[0-2]) : ;; *) return 1 ;; esac
        old_ifs="$IFS"; IFS='.'; set -- $ip; IFS="$old_ifs"
        o1="$1"; o2="$2"; o3="$3"; o4="$4"
        full=$((prefix / 8)); remaining=$((prefix % 8))
        case "$full" in
                0) [ "$remaining" -eq 0 ] && { [ "$o1" -eq 0 ] && [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ]; return $?; }
                   host_mask=$(( (1 << (8 - remaining)) - 1 )); [ $((o1 & host_mask)) -eq 0 ] && [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ] ;;
                1) [ "$remaining" -eq 0 ] && { [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ]; return $?; }
                   host_mask=$(( (1 << (8 - remaining)) - 1 )); [ $((o2 & host_mask)) -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ] ;;
                2) [ "$remaining" -eq 0 ] && { [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ]; return $?; }
                   host_mask=$(( (1 << (8 - remaining)) - 1 )); [ $((o3 & host_mask)) -eq 0 ] && [ "$o4" -eq 0 ] ;;
                3) [ "$remaining" -eq 0 ] && { [ "$o4" -eq 0 ]; return $?; }
                   host_mask=$(( (1 << (8 - remaining)) - 1 )); [ $((o4 & host_mask)) -eq 0 ] ;;
                4) [ "$remaining" -eq 0 ] ;;
                *) return 1 ;;
        esac
}

is_ipv6_candidate() {
        case "$1" in *:*) printf '%s' "$1" | grep -Eq '^[0-9A-Fa-f:]+$' ;; *) return 1 ;; esac
}

family_for() {
        if is_ipv4 "$1" || is_ipv4_cidr "$1"; then echo 4
        elif is_ipv6_candidate "$1"; then echo 6
        else echo 0
        fi
}

FAMILY="$(family_for "$TARGET")"
[ "$FAMILY" != 0 ] || die "IP o rete non valida: $TARGET"

removed=0
remove_from_file_by_first_field() {
        local file="$1" tmp
        [ -f "$file" ] || return 0
        if awk -v target="$TARGET" '$1==target {found=1} END{exit found ? 0 : 1}' "$file"; then
                tmp="$(mktemp "${file}.XXXXXX")"
                awk -v target="$TARGET" '$1!=target' "$file" > "$tmp"
                cat "$tmp" > "$file"; rm -f "$tmp"
                log "rimosso da file: $file -> $TARGET"; removed=1
        fi
}

delete_nft_element() {
        local table="$1" setname="$2"
        nft list set inet "$table" "$setname" >/dev/null 2>&1 || return 0
        if nft delete element inet "$table" "$setname" "{ $TARGET }" >/dev/null 2>&1; then
                log "rimosso da nft: inet $table $setname -> $TARGET"; removed=1
        fi
}

delete_f2bport_set_entries() {
        local setname="$1" tmp line entry_target port
        nft list set inet f2bport "$setname" >/dev/null 2>&1 || return 0
        tmp="$(mktemp /tmp/fw-unban-all.XXXXXX)"
        nft list set inet f2bport "$setname" 2>/dev/null \
                | sed -n '/elements = {/,/}/p' | tr ',' '\n' \
                | sed -e 's/^[[:space:]]*elements[[:space:]]*=[[:space:]]*{//' -e 's/}//g' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' > "$tmp"
        while IFS= read -r line; do
                [ -n "$line" ] || continue
                entry_target="$(printf '%s\n' "$line" | awk '{print $1}')"
                [ "$entry_target" = "$TARGET" ] || continue
                port="$(printf '%s\n' "$line" | awk '{for(i=1;i<=NF;i++) if($i=="." && (i+1)<=NF){v=$(i+1); sub(/[^0-9].*$/, "", v); if(v~/^[0-9]+$/){print v; exit}}}')"
                [ -n "$port" ] || continue
                if nft delete element inet f2bport "$setname" "{ $TARGET . $port }" >/dev/null 2>&1; then
                        log "rimosso da nft: inet f2bport $setname -> $TARGET porta $port"; removed=1
                fi
        done < "$tmp"
        rm -f "$tmp"
}

drop_conntrack() {
        command -v conntrack >/dev/null 2>&1 || return 0
        conntrack -D -s "$TARGET" >/dev/null 2>&1 || true
        conntrack -D -d "$TARGET" >/dev/null 2>&1 || true
        log "conntrack ripulita per $TARGET"
}

log "inizio unban totale per $TARGET"
remove_from_file_by_first_field /etc/banip/banip.blocklist
if nft list table inet banIP >/dev/null 2>&1; then
        [ "$FAMILY" = 4 ] && delete_nft_element banIP blocklist.v4 || delete_nft_element banIP blocklist.v6
fi

# Port-ban è opzionale e non fa parte del core RwF.
if [ "$FAMILY" = 4 ]; then
        remove_from_file_by_first_field /etc/f2b-portban/tcp4.perm
        remove_from_file_by_first_field /etc/f2b-portban/udp4.perm
else
        remove_from_file_by_first_field /etc/f2b-portban/tcp6.perm
        remove_from_file_by_first_field /etc/f2b-portban/udp6.perm
fi
if nft list table inet f2bport >/dev/null 2>&1; then
        if [ "$FAMILY" = 4 ]; then sets='tcp4_perm tcp4_temp udp4_perm udp4_temp'; else sets='tcp6_perm tcp6_temp udp6_perm udp6_temp'; fi
        for setname in $sets; do delete_f2bport_set_entries "$setname"; done
fi

drop_conntrack
[ "$removed" -eq 1 ] && { log "unban completato per $TARGET"; exit 0; }
log "nessun ban trovato per $TARGET"
exit 1
