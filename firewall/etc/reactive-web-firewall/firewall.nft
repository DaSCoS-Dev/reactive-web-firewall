table inet reactive_web_firewall {
    set permanent_v4 {
        type ipv4_addr
        flags interval
    }

    set temporary_v4 {
        type ipv4_addr
        flags interval,timeout
        timeout 1h
    }

    set permanent_v6 {
        type ipv6_addr
        flags interval
    }

    set temporary_v6 {
        type ipv6_addr
        flags interval,timeout
        timeout 1h
    }

    chain input {
        type filter hook input priority -200; policy accept;
        ip saddr @permanent_v4 drop
        ip saddr @temporary_v4 drop
        ip6 saddr @permanent_v6 drop
        ip6 saddr @temporary_v6 drop
    }

    chain forward {
        type filter hook forward priority -200; policy accept;
        ip saddr @permanent_v4 drop
        ip saddr @temporary_v4 drop
        ip6 saddr @permanent_v6 drop
        ip6 saddr @temporary_v6 drop
    }
}
