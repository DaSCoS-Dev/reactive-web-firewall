#!/bin/sh

RWF_CONFIG="${RWF_CONFIG:-/etc/reactive-web-firewall/firewall.conf}"

rwf_cfg() {
    key="$1"
    def="$2"
    val=""
    if [ -r "$RWF_CONFIG" ]; then
        val="$(sed -n "s/^${key}=//p" "$RWF_CONFIG" | tail -n 1)"
    fi
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$def"
}

rwf_is_ipv4() {
    value="$1"
    case "$value" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
    old_ifs="$IFS"; IFS='.'; set -- $value; IFS="$old_ifs"
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        case "$octet" in 0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) : ;; *) return 1 ;; esac
        [ "$octet" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

rwf_is_ipv4_cidr() {
    target="$1"
    case "$target" in */*) : ;; *) return 1 ;; esac
    ip="${target%/*}"; prefix="${target#*/}"
    case "$ip" in */*) return 1 ;; esac
    case "$prefix" in 0|[1-9]|[1-2][0-9]|3[0-2]) : ;; *) return 1 ;; esac
    rwf_is_ipv4 "$ip" || return 1

    old_ifs="$IFS"; IFS='.'; set -- $ip; IFS="$old_ifs"
    o1="$1"; o2="$2"; o3="$3"; o4="$4"
    full=$((prefix / 8)); rem=$((prefix % 8))

    case "$full" in
        0)
            if [ "$rem" -eq 0 ]; then [ "$o1" -eq 0 ] && [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ]; return $?; fi
            mask=$(( (1 << (8-rem)) - 1 )); [ $((o1 & mask)) -eq 0 ] && [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ] ;;
        1)
            if [ "$rem" -eq 0 ]; then [ "$o2" -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ]; return $?; fi
            mask=$(( (1 << (8-rem)) - 1 )); [ $((o2 & mask)) -eq 0 ] && [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ] ;;
        2)
            if [ "$rem" -eq 0 ]; then [ "$o3" -eq 0 ] && [ "$o4" -eq 0 ]; return $?; fi
            mask=$(( (1 << (8-rem)) - 1 )); [ $((o3 & mask)) -eq 0 ] && [ "$o4" -eq 0 ] ;;
        3)
            if [ "$rem" -eq 0 ]; then [ "$o4" -eq 0 ]; return $?; fi
            mask=$(( (1 << (8-rem)) - 1 )); [ $((o4 & mask)) -eq 0 ] ;;
        4) [ "$rem" -eq 0 ] ;;
        *) return 1 ;;
    esac
}

rwf_is_ipv6() {
    value="$1"
    printf '%s' "$value" | grep -Eq '^[0-9A-Fa-f:]+$' && printf '%s' "$value" | grep -q ':'
}

rwf_family() {
    if rwf_is_ipv4 "$1" || rwf_is_ipv4_cidr "$1"; then echo v4; return 0; fi
    if rwf_is_ipv6 "$1"; then echo v6; return 0; fi
    return 1
}

rwf_backend() {
    configured="$(rwf_cfg PERSIST_BACKEND auto)"
    case "$configured" in
        banip|standalone) echo "$configured"; return 0 ;;
        auto) : ;;
        *) echo "Invalid PERSIST_BACKEND=$configured" >&2; return 1 ;;
    esac

    table="$(rwf_cfg BANIP_TABLE banIP)"
    set4="$(rwf_cfg BANIP_SET_V4 blocklist.v4)"
    set6="$(rwf_cfg BANIP_SET_V6 blocklist.v6)"
    if nft list set inet "$table" "$set4" >/dev/null 2>&1 && nft list set inet "$table" "$set6" >/dev/null 2>&1; then
        echo banip
    else
        echo standalone
    fi
}

rwf_ensure_standalone_table() {
    table="$(rwf_cfg TABLE_NAME reactive_web_firewall)"
    ruleset="$(rwf_cfg RULESET /etc/reactive-web-firewall/firewall.nft)"
    nft list table inet "$table" >/dev/null 2>&1 || nft -f "$ruleset"
}

rwf_require_banip() {
    table="$(rwf_cfg BANIP_TABLE banIP)"
    set4="$(rwf_cfg BANIP_SET_V4 blocklist.v4)"
    set6="$(rwf_cfg BANIP_SET_V6 blocklist.v6)"
    nft list set inet "$table" "$set4" >/dev/null 2>&1 || return 1
    nft list set inet "$table" "$set6" >/dev/null 2>&1 || return 1
    return 0
}

rwf_drop_conntrack() {
    [ "$(rwf_cfg CONNTRACK_DROP 1)" = 1 ] || return 0
    command -v conntrack >/dev/null 2>&1 || return 0
    conntrack -D -s "$1" >/dev/null 2>&1 || true
    conntrack -D -d "$1" >/dev/null 2>&1 || true
}

rwf_lock_acquire() {
    lockdir=/var/lock/reactive-web-firewall.lock
    tries=0
    while ! mkdir "$lockdir" 2>/dev/null; do
        if [ -r "$lockdir/pid" ]; then
            owner="$(cat "$lockdir/pid" 2>/dev/null || true)"
            if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
                rm -rf "$lockdir" 2>/dev/null || true
                continue
            fi
        fi
        tries=$((tries + 1))
        [ "$tries" -lt 50 ] || { echo "Cannot acquire $lockdir" >&2; return 1; }
        sleep 0.1
    done
    printf '%s\n' "$$" > "$lockdir/pid"
    RWF_LOCKDIR="$lockdir"
    trap 'rwf_lock_release' EXIT HUP INT TERM
}

rwf_lock_release() {
    [ -n "${RWF_LOCKDIR:-}" ] && rm -rf "$RWF_LOCKDIR" 2>/dev/null || true
    RWF_LOCKDIR=""
}
