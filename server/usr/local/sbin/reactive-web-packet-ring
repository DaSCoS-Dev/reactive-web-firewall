#!/usr/bin/env bash
# Copyright (C) 2026 Daniele Stefano Continenza <daniele@dascos.info>
# SPDX-License-Identifier: AGPL-3.0-or-later
set -euo pipefail
CONFIG_LIB="${RWF_CONFIG_LIB:-/usr/local/lib/reactive-web-firewall/config.sh}"
if [[ ! -r "$CONFIG_LIB" ]]; then
    candidate="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib/reactive-web-firewall" 2>/dev/null && pwd)/config.sh"
    [[ -r "$candidate" ]] && CONFIG_LIB="$candidate"
fi
source "$CONFIG_LIB"

iface="$(rwf_cfg packet_ring_interface any)"
snaplen="$(rwf_cfg packet_ring_snaplen 96)"
buffer="$(rwf_cfg packet_ring_buffer_kb 4096)"
size="$(rwf_cfg packet_ring_file_size_mb 5)"
count="$(rwf_cfg packet_ring_file_count 20)"
dir="$(rwf_cfg packet_ring_directory /var/log/reactive-web-firewall/pcap)"
basename="$(rwf_cfg packet_ring_basename web.pcap)"
filter="$(rwf_cfg packet_ring_filter 'tcp and (port 80 or port 443)')"
for pair in "snaplen:$snaplen" "buffer:$buffer" "size:$size" "count:$count"; do
    name="${pair%%:*}"; value="${pair#*:}"; [[ "$value" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid $name: $value" >&2; exit 1; }
done
if [[ "${1:-}" == "--validate" ]]; then
    case "${2:-}" in '') ;; *) echo 'Unexpected packet-ring argument' >&2; exit 2;; esac
    rwf_bool "$(rwf_cfg packet_ring_enabled on)" || rc=$?
    [[ ${rc:-0} -ne 2 ]] || exit 1
    [[ "$dir" == /* ]] || { echo 'packet_ring_directory must be absolute' >&2; exit 1; }
    [[ "$basename" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo 'Invalid packet_ring_basename' >&2; exit 1; }
    echo "Packet ring configuration valid: interface=$iface files=$count size=${size}MB"
    exit 0
fi
mkdir -p "$dir"
[[ "$basename" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo 'Invalid packet_ring_basename' >&2; exit 1; }
exec /usr/bin/tcpdump -i "$iface" -nn -U -s "$snaplen" -B "$buffer" -C "$size" -W "$count" -Z tcpdump -w "$dir/$basename" "$filter"
