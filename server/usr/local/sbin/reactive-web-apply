set -euo pipefail
SKIP_WATCHER=0
case "${1:-}" in
    '') ;;
    --skip-watcher) SKIP_WATCHER=1 ;;
    *) echo 'Usage: reactive-web-apply [--skip-watcher]' >&2; exit 2 ;;
esac
CONFIG_LIB="${RWF_CONFIG_LIB:-/usr/local/lib/reactive-web-firewall/config.sh}"
if [[ ! -r "$CONFIG_LIB" ]]; then
    candidate="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib/reactive-web-firewall" 2>/dev/null && pwd)/config.sh"
    [[ -r "$candidate" ]] && CONFIG_LIB="$candidate"
fi
source "$CONFIG_LIB"

/usr/local/sbin/reactive-web-validate

apache_log="$(rwf_cfg apache_log_file /var/log/apache2/reactive_web_access.log)"
packet_enabled="$(rwf_cfg packet_ring_enabled on)"
packet_dir="$(rwf_cfg packet_ring_directory /var/log/reactive-web-firewall/pcap)"
rotate_frequency="$(rwf_cfg apache_log_rotate_frequency daily)"
rotate_count="$(rwf_cfg apache_log_rotate_count 14)"
[[ "$apache_log" == /* && "$apache_log" != *$'\n'* ]] || { echo 'Invalid apache_log_file' >&2; exit 1; }
[[ "$packet_dir" == /* && "$packet_dir" != *$'\n'* ]] || { echo 'Invalid packet_ring_directory' >&2; exit 1; }
[[ "$rotate_frequency" =~ ^(daily|weekly|monthly)$ ]] || { echo 'Invalid apache_log_rotate_frequency' >&2; exit 1; }
[[ "$rotate_count" =~ ^[1-9][0-9]*$ ]] && ((rotate_count <= 365)) || { echo 'Invalid apache_log_rotate_count' >&2; exit 1; }

install -d -m 0755 "$(dirname "$apache_log")"
touch "$apache_log"; chown root:adm "$apache_log"; chmod 0640 "$apache_log"
cat > /etc/apache2/conf-available/reactive-web-firewall.conf <<EOF
# Generated by reactive-web-apply. Edit reactive-web-firewall.conf instead.
LogFormat "%h (%v:%p) %l %u [%{%d/%b/%Y:%H:%M:%S}t.%{msec_frac}t %{%z}t] \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\" apache_end_us=%{end:usec}t" reactive_web
GlobalLog $apache_log reactive_web
EOF
cat > /etc/logrotate.d/reactive-web-firewall <<EOF
$apache_log {
    $rotate_frequency
    rotate $rotate_count
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
    sharedscripts
    postrotate
        systemctl reload apache2 >/dev/null 2>&1 || true
    endscript
}
EOF

install -d -o tcpdump -g tcpdump -m 0750 "$packet_dir"
a2enconf reactive-web-firewall >/dev/null
apache2ctl configtest
systemctl reload apache2
systemctl daemon-reload
systemctl restart reactive-web-fastban.service
if [[ $SKIP_WATCHER -eq 0 ]]; then
    systemctl restart reactive-web-ban.service
fi
if rwf_bool "$packet_enabled"; then
    systemctl enable --now reactive-web-packet-ring.service
    systemctl restart reactive-web-packet-ring.service
else
    systemctl disable --now reactive-web-packet-ring.service 2>/dev/null || true
fi

echo 'Reactive Web Firewall configuration applied.'
