#!/usr/bin/env bash
# Copyright (C) 2026 Daniele Stefano Continenza <daniele@dascos.info>
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail
CONFIG_LIB="${RWF_CONFIG_LIB:-/usr/local/lib/reactive-web-firewall/config.sh}"
if [[ ! -r "$CONFIG_LIB" ]]; then
    candidate="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib/reactive-web-firewall" 2>/dev/null && pwd)/config.sh"
    [[ -r "$candidate" ]] && CONFIG_LIB="$candidate"
fi
source "$CONFIG_LIB"

NFT="/usr/sbin/nft"
TABLE_FAMILY="inet"
TABLE_NAME="$(rwf_cfg local_fastban_table reactive_web_fastban)"
DEFAULT_TIMEOUT="$(rwf_cfg local_fastban_timeout 5m)"
PORTS_RAW="$(rwf_cfg local_fastban_ports 80,443)"
PRIORITY="$(rwf_cfg local_fastban_priority -250)"
PORTS_NFT="$(rwf_ports_csv_to_nft "$PORTS_RAW")"

[[ "$TABLE_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo 'Invalid local_fastban_table' >&2; exit 1; }
[[ "$PRIORITY" =~ ^-?[0-9]+$ ]] || { echo 'Invalid local_fastban_priority' >&2; exit 1; }
DEFAULT_SECONDS="$(rwf_duration_seconds "$DEFAULT_TIMEOUT")"
(( DEFAULT_SECONDS >= 10 && DEFAULT_SECONDS <= 3600 )) || { echo 'local_fastban_timeout must be 10..3600 seconds' >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage:
  reactive-web-fastban add IP [timeout]
  reactive-web-fastban del IP
  reactive-web-fastban check IP
  reactive-web-fastban list
  reactive-web-fastban render
  reactive-web-fastban reload
  reactive-web-fastban stop
EOF
    exit 2
}

set_for_ip() { case "$1" in *:*) echo fastban_v6;; *.*) echo fastban_v4;; *) echo "Invalid IP: $1" >&2; exit 1;; esac; }

render() {
    cat <<EOF
table inet $TABLE_NAME {
    set fastban_v4 {
        type ipv4_addr
        flags timeout
        timeout ${DEFAULT_SECONDS}s
    }
    set fastban_v6 {
        type ipv6_addr
        flags timeout
        timeout ${DEFAULT_SECONDS}s
    }
    chain input {
        type filter hook input priority $PRIORITY; policy accept;
        ip saddr @fastban_v4 tcp dport { $PORTS_NFT } counter drop
        ip6 saddr @fastban_v6 tcp dport { $PORTS_NFT } counter drop
    }
}
EOF
}

ensure_table() { "$NFT" list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || reload_table; }
reload_table() {
    local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
    "$NFT" list table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 && echo "delete table $TABLE_FAMILY $TABLE_NAME" >> "$tmp"
    render >> "$tmp"
    "$NFT" -c -f "$tmp"
    "$NFT" -f "$tmp"
    rm -f "$tmp"; trap - RETURN
}

cmd="${1:-}"
case "$cmd" in
    render) render ;;
    reload) reload_table ;;
    stop) "$NFT" delete table "$TABLE_FAMILY" "$TABLE_NAME" >/dev/null 2>&1 || true ;;
    list) ensure_table; "$NFT" -a list table "$TABLE_FAMILY" "$TABLE_NAME" ;;
    add)
        [[ $# -ge 2 && $# -le 3 ]] || usage
        ip="$2"; timeout="${3:-$DEFAULT_TIMEOUT}"; seconds="$(rwf_duration_seconds "$timeout")"; setname="$(set_for_ip "$ip")"; ensure_table
        if "$NFT" add element "$TABLE_FAMILY" "$TABLE_NAME" "$setname" "{ $ip timeout ${seconds}s }" >/dev/null 2>&1 || "$NFT" get element "$TABLE_FAMILY" "$TABLE_NAME" "$setname" "{ $ip }" >/dev/null 2>&1; then
            logger -t reactive-web-fastban "manual-add ip=$ip set=$setname timeout=${seconds}s rc=0"; exit 0
        fi
        exit 1
        ;;
    del)
        [[ $# -eq 2 ]] || usage
        ip="$2"; setname="$(set_for_ip "$ip")"; ensure_table
        if "$NFT" delete element "$TABLE_FAMILY" "$TABLE_NAME" "$setname" "{ $ip }" >/dev/null 2>&1 || ! "$NFT" get element "$TABLE_FAMILY" "$TABLE_NAME" "$setname" "{ $ip }" >/dev/null 2>&1; then
            logger -t reactive-web-fastban "manual-del ip=$ip set=$setname rc=0"; exit 0
        fi
        exit 1
        ;;
    check)
        [[ $# -eq 2 ]] || usage
        ip="$2"; setname="$(set_for_ip "$ip")"; ensure_table
        "$NFT" get element "$TABLE_FAMILY" "$TABLE_NAME" "$setname" "{ $ip }"
        ;;
    *) usage ;;
esac
