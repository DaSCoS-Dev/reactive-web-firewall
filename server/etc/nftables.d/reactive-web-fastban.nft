table inet reactive_web_fastban {
    set fastban_v4 {
        type ipv4_addr
        flags timeout
        timeout 5m
    }

    set fastban_v6 {
        type ipv6_addr
        flags timeout
        timeout 5m
    }

    chain input {
        type filter hook input priority -250; policy accept;

        ip saddr @fastban_v4 tcp dport { 80, 443 } counter drop
        ip6 saddr @fastban_v6 tcp dport { 80, 443 } counter drop
    }
}
