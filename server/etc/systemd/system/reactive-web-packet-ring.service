[Unit]
Description=Reactive Web Firewall circular packet recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/reactive-web-packet-ring
Restart=always
RestartSec=2
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=false

[Install]
WantedBy=multi-user.target
